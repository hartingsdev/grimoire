# Compose-level configuration. Copy to .env in this directory.
#
# This file is NOT the configuration of an instance — that lives in
# .env.personal and .env.work. Compose reads this one only to substitute
# variables in docker-compose.yml.

# Which published image to run. Pin an exact version for a server; "latest"
# means the next `docker compose pull` may bring a new release unannounced.
GRIMOIRE_TAG=latest
